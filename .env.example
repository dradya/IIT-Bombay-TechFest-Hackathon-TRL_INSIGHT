# =====================================================================
# TRL INSIGHT - environment configuration (copy to ".env" to customise)
# All defaults work for local development - no API keys are required.
# =====================================================================

# Application
TRL_ENV=development
TRL_DEBUG=true
TRL_LOG_LEVEL=INFO

# Server (used by scripts\start*.bat / scripts\start.sh)
# Note: the frontend dev proxy targets 127.0.0.1:8000 — if you change
# TRL_PORT you must also update the proxy in frontend/vite.config.ts.
TRL_HOST=127.0.0.1
TRL_PORT=8000

# CORS (comma separated origins used by the Vite dev server)
TRL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Storage (defaults: backend/data, backend/models, backend/config)
# TRL_DATA_DIR=C:/trl-insight/data
# TRL_MODELS_DIR=C:/trl-insight/models

# Uploads
TRL_MAX_UPLOAD_SIZE_MB=25

# Optional OCR for scanned PDFs (requires pytesseract + Tesseract-OCR)
TRL_OCR_ENABLED=false
# TRL_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
